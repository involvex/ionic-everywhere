{
	"name": "@involvex/ionic-everywhere",
	"version": "0.1.0",
	"description": "Scaffold one responsive Ionic React codebase that builds Web, Android and Desktop apps.",
	"keywords": [
		"ionic",
		"capacitor",
		"electron",
		"cross-platform",
		"scaffolding",
		"cli",
		"react"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/involvex/ionic-everywhere"
	},
	"license": "MIT",
	"author": "involvex",
	"type": "module",
	"bin": {
		"create-ionic-everywhere": "./dist/cli.js",
		"ine": "./dist/cli.js",
		"ionic-everywhere": "./dist/cli.js"
	},
	"files": [
		"dist",
		"templates"
	],
	"scripts": {
		"build": "bun build src/cli.ts --outfile=dist/cli.js --target=node --format=esm",
		"dev": "bun run --hot src/cli.ts",
		"prepublishOnly": "bun run build",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@clack/prompts": "^1.7.0"
	},
	"devDependencies": {
		"@types/node": "^26.3.0",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=20"
	}
}
