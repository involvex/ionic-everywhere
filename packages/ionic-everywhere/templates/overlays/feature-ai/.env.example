# Optional Vite env defaults for the with-ai template.
# Prefer configuring backends in the in-app Settings screen.
# Never commit real API keys.

# OpenCode serve / shared service (default)
# VITE_OPENCODE_BASE_URL=http://127.0.0.1:4096

# OpenAI-compatible fallback (only if you are not using OpenCode)
# VITE_OPENAI_BASE_URL=https://api.openai.com/v1
# VITE_OPENAI_MODEL=gpt-4o-mini
# VITE_OPENAI_API_KEY=
