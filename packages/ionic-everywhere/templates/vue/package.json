{
	"name": "__APP_NAME_KEBAB__",
	"version": "0.1.0",
	"private": true,
	"description": "__APP_NAME__ - built with @involvex/ionic-everywhere (Vue)",
	"type": "module",
	"scripts": {
		"assets": "npx @capacitor/assets generate --android --assetPath assets",
		"preandroid": "npm run build && cap sync android",
		"android": "cap run android",
		"android:dev": "node scripts/android-dev.mjs",
		"build": "vue-tsc --noEmit && vite build",
		"build:all": "npm run build:android && npm run build:desktop",
		"build:android": "npm run build && cap sync android && node scripts/gradle.mjs assembleDebug",
		"build:desktop": "npm run build && cap sync @capawesome/capacitor-electron && cd electron && npm run pack",
		"predesktop": "npm run build && cap sync @capawesome/capacitor-electron",
		"desktop": "cd electron && npm run start",
		"desktop:dev": "node scripts/desktop-dev.mjs",
		"dev": "vite",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"open:android": "cap open android",
		"preview": "vite preview",
		"sync": "npm run build && cap sync android && cap sync @capawesome/capacitor-electron",
		"typecheck": "vue-tsc --noEmit"
	},
	"dependencies": {
		"@capacitor/android": "^8.5.3",
		"@capacitor/core": "^8.5.3",
		"@capacitor/preferences": "^8.0.1",
		"@capawesome/capacitor-electron": "^0.2.2",
		"@ionic/vue": "^9.0.7",
		"@ionic/vue-router": "^9.0.7",
		"ionicons": "^8.1.0",
		"vue": "^3.5.22",
		"vue-router": "^4.5.1"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.5.3",
		"@eslint/js": "^10.0.1",
		"@vitejs/plugin-vue": "^6.0.1",
		"eslint": "^10.12.0",
		"eslint-plugin-vue": "^10.4.0",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vite-plugin-pwa": "^1.3.0",
		"vue-eslint-parser": "^10.2.0",
		"vue-tsc": "^3.1.0",
		"workbox-window": "^7.4.1"
	}
}
