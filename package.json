{
	"name": "ionic-everywhere-monorepo",
	"version": "0.1.0",
	"private": true,
	"description": "@involvex/ionic-everywhere - one responsive Ionic React codebase that builds web, Android and desktop",
	"author": "involvex",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"prebuild": "bun run verify",
		"build": "bun run --filter @involvex/ionic-everywhere build",
		"ci:lint-test": "bun run verify && bunx tsc -p packages/ionic-everywhere/tsconfig.json --noEmit && bun run build",
		"clean": "bun scripts/clean.mjs",
		"cli:dev": "bun run --filter @involvex/ionic-everywhere dev",
		"cli:test": "bun run build && bun scripts/cli-test.mjs",
		"format": "prettier . --write",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"verify": "bun run format && bun run lint:fix && bun run test"
	},
	"prettier": "@involvex/prettier-config",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.3.0",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.0.0",
		"globals": "^17.11.0",
		"prettier": "^3.8.2",
		"prettier-plugin-markdown-html": "^1.6.0",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-packagejson": "^3.0.2",
		"prettier-plugin-prisma": "^5.0.0",
		"prettier-plugin-properties": "^0.3.1",
		"prettier-plugin-toml": "^2.0.6",
		"prettier-plugin-yaml": "^1.3.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.68.0",
		"vitest": "^4.1.11"
	}
}
